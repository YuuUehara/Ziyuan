    ]},
    {"id": "c03", "source_name": "m-third.txt", "paragraphs": [
      {"id": "p07", "block": "b04", "source": "昨日のことを思い出した。女の本名は美緒だった。", "target": "她想起昨天的事。那个女人的真名叫美绪。"},
      {"id": "p08", "block": "b04", "source": "この町で「月舟」は祭りの灯籠を指す。船ではない。", "target": "在这座镇子里，“月舟”指祭典的灯笼，并不是船。"},
      {"id": "p09", "block": "b05", "source": "蓮は月舟を持って港へ戻った。", "target": "莲提着月舟回到港口。"}
    ]}
